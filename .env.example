# Optional model explanation. The deterministic local recommendation works without it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# AMap: server key for walking distances; public JS key must use domain allowlists.
AMAP_WEB_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

# Use separate stores and values for Preview and Production.
COFFEE_DATA_BLOB_READ_WRITE_TOKEN=
COFFEE_DATA_BLOB_STORE_ID=
COFFEE_MEDIA_BLOB_READ_WRITE_TOKEN=
COFFEE_MEDIA_BLOB_STORE_ID=
ADMIN_ACCESS_TOKEN=
APP_ORIGIN=http://localhost:3000
