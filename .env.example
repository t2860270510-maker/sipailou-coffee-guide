DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-your-own-key

# Optional fallback models, comma-separated:
# DEEPSEEK_FALLBACK_MODELS=deepseek-v4-pro

# Backward-compatible aliases if you already configured the previous provider:
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# MINIMAX_MODEL=MiniMax-M2.7
# MINIMAX_FALLBACK_MODELS=MiniMax-M2.5
# MINIMAX_API_KEY=replace-with-your-own-key

# Backward-compatible aliases if you already used Anthropic-style names:
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_MODEL=deepseek-v4-flash
# ANTHROPIC_API_KEY=replace-with-your-own-key
